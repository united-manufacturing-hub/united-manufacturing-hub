# Cache everything except the specific files we need
.docker-cache/*
!.docker-cache/s6-overlay/
!.docker-cache/benthos/
!.docker-cache/redpanda/

tmp/
data/

metrics.txt

# Git metadata
.git
.gitignore
.gitattributes

# Documentation and non-code assets
docs/
examples/
changelog-images/
*.md
*.txt

# Test files (not needed for the binary)
**/*_test.go
tools/
integration/
test/

# The Management Console module's source never goes into the image context;
# the official build fetches it at the version go.mod pins.
vendor/github.com/united-manufacturing-hub/ManagementConsole/
